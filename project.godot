; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BLACKVEIN"
config/description="An open-world super-power action game: shapeshifting powers, wall running, a military that hunts you, and a city full of events."
run/main_scene="res://scenes/main.tscn"
config/version="0.6.0"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

Controls="*res://scripts/controls.gd"
Game="*res://scripts/game.gd"
Settings="*res://scripts/settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssil/quality=2
anti_aliasing/screen_space_roughness_limiter/enabled=true
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=4096
